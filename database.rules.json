{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "auth.uid === $uid ? newData.val() === 'user' : (newData.val() === 'user' || newData.val() === 'admin')"
        }
      }
    },

    "sensors": {
      "$sensorId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('members').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && data.child('members').child(auth.uid).exists()) || (!data.exists() && newData.child('members').child(auth.uid).exists() && newData.child('memberCount').val() === 1))",

        "memberCount": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },

        "members": {
          ".read": "auth != null",
          "$memberUid": {
            ".write": "auth != null && auth.uid === $memberUid && data.parent().parent().exists()",
            ".validate": "newData.isBoolean() && (data.exists() || (data.parent().parent().child('memberCount').val() < 3 && newData.parent().parent().child('memberCount').val() === data.parent().parent().child('memberCount').val() + 1))"
          }
        }
      }
    },

    "alerts": {
      "$alertId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('sensors').child(data.child('tankId').val()).child('members').child(auth.uid).exists())",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "history": {
      "$tankId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('sensors').child($tankId).child('members').child(auth.uid).exists())",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}
